{
  "name": "@konomanoasa/tree-sitter-posix-awk",
  "version": "0.15.0",
  "type": "module",
  "description": "Tree-sitter grammar for POSIX awk.",
  "license": "MIT",
  "repository": "git+https://github.com/konomanoasa/tree-sitter-posix-awk.git",
  "files": [
    "Cargo.toml",
    "bindings/rust/*.rs",
    "grammar.js",
    "queries/*.scm",
    "src/*.c",
    "src/*.json",
    "src/tree_sitter/*.h",
    "tree-sitter.json"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "check": "biome check . && node scripts/check-c.js && cargo fmt --check && cargo check --all-targets --locked && cargo clippy --all-targets --locked -- -D warnings && node scripts/check-generated.js && npm test",
    "format": "biome check --write . && node scripts/check-c.js --write && cargo fmt",
    "generate": "npm run tree-sitter -- generate-all",
    "parse": "npm run tree-sitter -- parse --scope source.awk",
    "test": "npm run tree-sitter -- test-corpus --rebuild && npm run test:fuzz:corpus && node --test --test-concurrency=1 \"test/*.test.js\" && cargo test --locked",
    "test:fuzz": "node --test --test-name-pattern=\"fixed-seed generated histories\" test/incremental.test.js",
    "test:fuzz:corpus": "npm run tree-sitter -- fuzz-all --iterations 3000 --edits 8",
    "test:highlights": "node --test test/highlight.test.js",
    "test:incremental": "node --test test/incremental.test.js",
    "test:sanitize": "node scripts/check-c.js --sanitize",
    "test:scanner": "node scripts/check-c.js",
    "tree-sitter": "node scripts/tree-sitter.js"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "26.5.1",
    "tree-sitter-cli": "0.27.0"
  },
  "allowScripts": {
    "tree-sitter-cli": true
  }
}
